# Salin menjadi .env lalu ubah yang perlu. Baris yang dikomentari memakai nilai bawaan.
# Environment variable asli (export / set) selalu menang atas file ini.

# ---- Umum ------------------------------------------------------------
# Folder hasil klip
# CLIPPER_OUTPUT_DIR=output
# Kualitas bawaan: best | 1080 | 720 | 480 | 360 | audio (audio = mp3)
# CLIPPER_QUALITY=best
# Mode bawaan: auto (deteksi livestream) | live | vod
# CLIPPER_MODE=auto
# Pemotongan presisi pada video biasa (render ulang titik potong). false = cepat tapi bisa meleset
# CLIPPER_PRECISE=true
# Lama potongan pada mode uji (--test), dalam detik
# CLIPPER_TEST_SECONDS=10
# Panjang maksimal judul pada nama file
# CLIPPER_TITLE_MAX=80

# ---- Frame (ukuran/rasio hasil) ---------------------------------------
# original | tiktok | reels | shorts | instagram (4:5) | square (1:1) | youtube (16:9) | twitter | cinema
# atau rasio "3:4" / ukuran "720x1280". Lihat semua: python cli.py --list-frames
# CLIPPER_FRAME=original
# Cara mengisi frame: blur (latar buram) | crop (potong tengah) | pad (bingkai hitam)
# CLIPPER_FIT=blur
# Posisi horizontal potongan untuk fit=crop: 0 kiri, 0.5 tengah, 1 kanan
# CLIPPER_FOCUS=0.5

# ---- Subtitle ---------------------------------------------------------
# off | youtube (caption YouTube) | whisper (transkripsi AI) | auto (caption YouTube, lalu Whisper)
# CLIPPER_SUBS=off
# auto = bahasa dideteksi otomatis, atau kode seperti id, en, ja
# CLIPPER_SUB_LANG=auto
# burn (tertanam di video) | soft (track yang bisa dimatikan) | srt (file .srt terpisah)
# CLIPPER_SUB_MODE=burn
# Pengali ukuran teks (0.5-2.0) dan nama font (kosong = font bawaan sistem)
# CLIPPER_SUB_SCALE=1.0
# CLIPPER_SUB_FONT=
# Whisper: tiny | base | small | medium | large-v3 (makin besar = makin akurat, makin lambat/berat)
# CLIPPER_WHISPER_MODEL=base
# auto | cpu | cuda      (compute: auto | int8 | float16 | ...)
# CLIPPER_WHISPER_DEVICE=auto
# CLIPPER_WHISPER_COMPUTE=auto
# Folder penyimpanan model (agar tidak diunduh ulang)
# CLIPPER_WHISPER_DIR=

# ---- ffmpeg (isi jika tidak ada di PATH) -----------------------------
# Boleh folder atau path file ffmpeg. ffprobe dicari di folder yang sama.
# CLIPPER_FFMPEG_PATH=C:\ffmpeg\bin
# CLIPPER_FFPROBE_PATH=

# ---- Jaringan & akun -------------------------------------------------
# Proxy untuk yt-dlp dan unduhan segmen live, mis. http://user:pass@host:8080
# CLIPPER_PROXY=
# Cookies untuk video yang meminta login / anti-bot. Pilih salah satu:
# CLIPPER_COOKIES_FILE=cookies.txt
# CLIPPER_COOKIES_FROM_BROWSER=chrome        # atau firefox, edge, brave, firefox:NAMA_PROFIL

# ---- Mode live -------------------------------------------------------
# Jumlah unduhan segmen paralel (1-16)
# CLIPPER_LIVE_WORKERS=4
# Segmen cadangan di tiap sisi rentang (0-5). 1 sudah cukup untuk kebanyakan kasus
# CLIPPER_LIVE_MARGIN=1
# Percobaan ulang per segmen dan batas waktu HTTP (detik)
# CLIPPER_LIVE_RETRIES=4
# CLIPPER_HTTP_TIMEOUT=30

# ---- Hasil render (mode live, selalu render ulang) -------------------
# Preset x264: ultrafast ... veryfast ... medium ... veryslow (lambat = file lebih kecil)
# CLIPPER_VIDEO_PRESET=veryfast
# CRF 0-51 (kecil = kualitas lebih tinggi, file lebih besar)
# CLIPPER_VIDEO_CRF=20
# CLIPPER_AUDIO_BITRATE=192k

# ---- Web UI ----------------------------------------------------------
# Gunakan 0.0.0.0 hanya jika memang ingin diakses dari perangkat lain di jaringan
# CLIPPER_HOST=127.0.0.1
# CLIPPER_PORT=5000

# ---- Server / deployment (web UI) --------------------------------------
# Login Basic Auth. Wajib diisi jika web dapat diakses dari luar komputer sendiri.
# CLIPPER_AUTH_USER=
# CLIPPER_AUTH_PASSWORD=
# Jumlah render bersamaan (sisanya antre) dan batas durasi klip (detik, 0 = tanpa batas)
# CLIPPER_MAX_JOBS=2
# CLIPPER_MAX_CLIP_SECONDS=0
# Hapus file hasil otomatis setelah sekian jam (0 = tidak dihapus)
# CLIPPER_RETENTION_HOURS=0
# Batasi domain yang boleh diunduh, pisahkan dengan koma (kosong = semua)
# CLIPPER_ALLOWED_DOMAINS=youtube.com,youtu.be
